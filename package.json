{
  "name": "pi-jev",
  "version": "0.1.0",
  "description": "TypeSafe Jev (System One) decision tools for pi: calibrated noul/choice/score questions, /jev panel, auto-installed official skill, and Noul as a permission authorizer.",
  "type": "module",
  "main": "./src/index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "typesafe",
    "jev",
    "system-one",
    "decision-model",
    "calibration"
  ],
  "license": "MIT",
  "author": "ioOvOoi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ioOvOoi/Pi-Jev.git"
  },
  "files": [
    "src/",
    "scripts/",
    "README.md",
    "README.zh-CN.md",
    "CONTEXT.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "smoke:skill": "tsx scripts/smoke-skill.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.6",
    "typebox": "*"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typebox": "^1.3.7",
    "typescript": "^5.6.0"
  }
}
